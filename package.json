{
  "name": "playtogether-monorepo",
  "version": "1.0.0",
  "description": "PlayTogether Full Game Suite",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "concurrently \"npm run start --workspace=server\" \"npm run dev --workspace=client\"",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
